# ── Required ──────────────────────────────────────────────────────────────────

# Your Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Your personal Telegram user ID (from @userinfobot) — only you can use the bot
TELEGRAM_USER_ID=

# ── Claude working directory ──────────────────────────────────────────────────

# Directory where Claude Code will run (defaults to $HOME)
CLAUDE_WORKDIR=/home/youruser

# ── Python tools (optional — defaults to system python3) ─────────────────────

# Python interpreter for URL/PDF extraction tools
# If you use a virtualenv: /path/to/venv/bin/python3
BOT_TOOLS_PYTHON=python3

# Python interpreter for Whisper voice transcription
# Requires openai-whisper installed: pip install openai-whisper
WHISPER_PYTHON_BIN=python3

# ── Approval server ports (optional) ─────────────────────────────────────────

# Internal HTTP server for Claude Code approval hooks
APPROVAL_PORT=3456

# Web UI server for browser-based approvals
WEB_APPROVAL_PORT=3457

# Secret token for the web approval UI (auto-disabled if empty)
WEB_APPROVAL_TOKEN=

# ── Service monitor (optional) ────────────────────────────────────────────────

# Comma-separated list of systemd services to monitor
# Example: MONITOR_SERVICES=myapp,nginx,postgresql
MONITOR_SERVICES=claude-telegram,nginx
